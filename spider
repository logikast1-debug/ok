   # Функція, яка працює у фоні і постійно приймає дані від сервера
   def recv_message(self):
       buffer = ""  # Порожній рядок-буфер для накопичення шматків даних
       while True:  # Безкінечний цикл
           try:
               # Чекаємо на отримання порції даних до 4096 байт
               chunk = self.sock.recv(4096)
               if not chunk:  # Якщо прийшло порожнє значення (сервер відключився)
                   break
               # Декодуємо байти в текст, ігноруючи зламані символи (errors='ignore')
               buffer += chunk.decode('utf-8', errors='ignore')


               # Поки в буфері є символ кінця повідомлення (\n)
               while "\n" in buffer:
                   # Розрізаємо буфер на дві частини: ПЕРШУ повну лінію та ВСЕ ІНШЕ (залишок)
                   line, buffer = buffer.split("\n", 1)
                   # Відправляємо повну лінію на розбір
                   self.handle_line(line.strip())


           except:
               break
       self.sock.close()  # Закриваємо з'єднання, якщо сталася помилка


   # Розбір (парсинг) вхідного повідомлення
   def handle_line(self, line):
       if not line:  # Якщо рядок порожній - ігноруємо
           return
       # Розділяємо повідомлення по символу '@' максимум на 4 частини
       parts = line.split("@", 3)
       msg_type = parts[0]  # Перша частина - це тип (TEXT або IMAGE)


       if msg_type == "TEXT":
           if len(parts) >= 3:  # Перевіряємо, чи є автор і текст
               author = parts[1]
               message = parts[2]
               self.add_message(f"{author}: {message}")  # Виводимо в чат


       elif msg_type == "IMAGE":
           if len(parts) >= 4:  # Перевіряємо, чи є автор, назва і код картинки
               author = parts[1]
               filename = parts[2]
               b64_img = parts[3]  # Це сам текст картинки у форматі Base64
               try:
                   # Декодуємо текст назад у двійкові байти
                   img_data = base64.b64decode(b64_img)
                   # Відкриваємо ці байти як віртуальний файл-картинку за допомогою PIL
                   pil_img = Image.open(io.BytesIO(img_data))
                   # Конвертуємо у формат, який розуміє CustomTkinter
                   ctk_img = CTkImage(pil_img, size=(300, 300))
                   # Додаємо повідомлення з картинкою
                   self.add_message(f"{author} надіслав(ла) зображення: {filename}", img=ctk_img)
               except Exception as e:
                   # Якщо під час декодування сталася помилка
                   self.add_message(f"Помилка відображення зображення: {e}")
       else:
           # Якщо це системне повідомлення без протоколу
           self.add_message(line)


   # Функція для вибору та відправки картинки з комп'ютера
   def open_image(self):
       # Викликаємо системне вікно для вибору файлу
       file_name = filedialog.askopenfilename()
       if not file_name:  # Якщо користувач натиснув "Скасувати"
           return
       try:
           # Відкриваємо файл на читання ('r') у двійковому форматі ('b')
           with open(file_name, "rb") as f:
               raw = f.read()  # Читаємо всі байти файлу
           # Кодуємо байти у текстовий рядок Base64 і декодуємо результат у звичайний текст
           b64_data = base64.b64encode(raw).decode()
           # Отримуємо тільки назву файлу з усього шляху (наприклад, з C:/images/cat.jpg отримуємо cat.jpg)
           short_name = os.path.basename(file_name)


           # Формуємо пакет даних за протоколом IMAGE
           data = f"IMAGE@{self.username}@{short_name}@{b64_data}\n"
           # Відправляємо на сервер
           self.sock.sendall(data.encode())
           # Виводимо картинку в своєму вікні чату, щоб побачити, що ми відправили
           self.add_message('', CTkImage(light_image=Image.open(file_name), size=(300, 300)))
       except Exception as e:
           self.add_message(f"Не вдалося надіслати зображення: {e}")




